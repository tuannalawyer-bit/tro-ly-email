<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xsi:type="MailApp">

  <!-- GUID đổi mới ở v1.4.1: bản v1.3 cũ dùng 1f8f5c4a-5df6-4c77-9c69-9e7c8c3a2a11
       và KHÔNG có VersionOverrides. Outlook khoá add-in theo Id này nên vẫn phục vụ
       metadata đã cache, khiến nút ribbon không bao giờ xuất hiện. Đổi Id buộc Outlook
       coi đây là add-in hoàn toàn mới. -->
  <Id>0d0daf77-eba5-4a54-9569-c2fa18eac48c</Id>
  <Version>2.1.1.0</Version>
  <ProviderName>Email Assistant</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="Trợ lý Email"/>
  <Description DefaultValue="Đọc email và tệp đính kèm, soạn thư trả lời bằng Gemini theo văn phong của bạn."/>
  <IconUrl DefaultValue="https://localhost:8765/addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8765/addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://localhost:8765/addin/taskpane.html"/>

  <AppDomains>
    <AppDomain>https://localhost:8765</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <!-- Giữ 1.5 để add-in vẫn nạp được; các API 1.8/1.9 được kiểm tra lúc chạy
           bằng Office.context.requirements.isSetSupported. -->
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <!-- Giữ khối này làm đường lui: nếu VersionOverrides bị client từ chối thì
       cùng lắm mất nút ribbon, task pane vẫn mở được theo cách cũ. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:8765/addin/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadItem là đủ cho: đọc body/subject/from, liệt kê đính kèm,
       getAttachmentContentAsync và displayReplyForm.
       KHÔNG dùng ReadWriteMailbox: quyền đó mở cả makeEwsRequestAsync trên
       toàn hộp thư, rộng hơn nhu cầu rất nhiều. -->
  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- VersionOverrides BẮT BUỘC là phần tử cuối cùng của OfficeApp. -->
  <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
      xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- FunctionFile là con đầu tiên bắt buộc, kể cả khi mọi Control
               đều là ShowTaskpane. -->
          <FunctionFile resid="functionFile"/>

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="grpTroLyEmail">
                <Label resid="grpLabel"/>
                <Control xsi:type="Button" id="btnMoTroLy">
                  <Label resid="btnLabel"/>
                  <Supertip>
                    <Title resid="btnLabel"/>
                    <Description resid="btnTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://localhost:8765/addin/assets/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="https://localhost:8765/addin/assets/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="https://localhost:8765/addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://localhost:8765/addin/taskpane.html"/>
        <bt:Url id="functionFile" DefaultValue="https://localhost:8765/addin/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="grpLabel" DefaultValue="Trợ lý Email"/>
        <bt:String id="btnLabel" DefaultValue="Soạn trả lời AI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnTip" DefaultValue="Đọc email và tệp đính kèm rồi soạn thư trả lời bằng Gemini theo văn phong của bạn."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
