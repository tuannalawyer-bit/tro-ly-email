GEMINI_API_KEY=

# Hạn mức miễn phí tính RIÊNG cho từng model, và model càng mới hạn mức càng THẤP.
# KHÔNG dùng bí danh gemini-flash-latest: nó luôn trỏ tới model mới nhất, tức là
# model có hạn mức thấp nhất (đo ngày 05-08-2026: chỉ 20 lượt/ngày, khoảng 6 thư).
# Các lựa chọn đã thử chạy được:
#   gemini-3.1-flash-lite  nhanh nhất (~0,7s/lượt), hạn mức miễn phí cao nhất
#   gemini-3.5-flash       chất lượng cao hơn nhưng chậm (~9,6s/lượt)
GEMINI_MODEL=gemini-3.1-flash-lite
